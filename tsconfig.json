{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["./.cloudflare/types/index.d.ts"],
    "noEmit": true
  },
  "include": ["src", "cloudflare.config.ts"]
}
